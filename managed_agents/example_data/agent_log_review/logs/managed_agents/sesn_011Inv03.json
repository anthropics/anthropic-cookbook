     "input": {
      "file_path": "/work/parse.py",
      "content": "import json, sys, pathlib, pdfplumber\nrows = []\nfor pdf in sorted(pathlib.Path(sys.argv[1]).glob(\"*.pdf\")):\n    text = \"\\n\".join(p.extract_text() or \"\" for p in pdfplumber.open(pdf).pages)\n    po = next((l.split()[-1] for l in text.splitlines() if l.startswith(\"PO Number\")), None)\n    total = next((l.split()[-1] for l in text.splitlines() if l.startswith(\"Total Due\")), None)\n    rows.append({\"invoice\": pdf.stem, \"po\": po, \"total\": total})\njson.dump(rows, sys.stdout, indent=1)\n"
     },
     "evaluated_permission": "allow",
     "evaluation": {
